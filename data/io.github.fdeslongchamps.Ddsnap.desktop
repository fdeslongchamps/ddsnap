[Desktop Entry]
Type=Application
Name=Ddsnap
Comment=Choisir des calques PSD et les exporter en textures DDS
Exec=ddsnap-gui %f
Icon=io.github.fdeslongchamps.Ddsnap
Terminal=false
Categories=Graphics;2DGraphics;
MimeType=image/vnd.adobe.photoshop;image/x-photoshop;image/vnd-ms.dds;image/x-dds;
Keywords=dds;psd;texture;layers;calques;mod;skin;game;jeu;
StartupNotify=true
# Use the discrete GPU (NVIDIA) for the preview when one is present; GNOME falls back otherwise.
PrefersNonDefaultGPU=true
X-KDE-RunOnDiscreteGpu=true
